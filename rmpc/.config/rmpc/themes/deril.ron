#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    multiple_tag_resolution_strategy: All,
    browser_column_widths: [20, 38, 42],
    background_color: "#1c2128",
    modal_backdrop: true,
    text_color: "#c9d1d9",
    header_background_color: "#1c2128",
    modal_background_color: "#1c2128",
    preview_label_style: (fg: "#9a8fb8"),
    preview_metadata_group_style: (fg: "#6f9bd1"),
    song_table_album_separator: None,
    tab_bar: (
        active_style: (fg: "#1c2128", bg: "#6f9bd1", modifiers: "Bold"),
        inactive_style: (fg: "#6b7686", bg: "#1c2128"),
    ),
    highlighted_item_style: (fg: "#8fb996", modifiers: "Bold"),
    current_item_style: (fg: "#1c2128", bg: "#6f9bd1", modifiers: "Bold"),
    borders_style: (fg: "#6f9bd1", modifiers: "Bold"),
    highlight_border_style: (fg: "#6f9bd1"),
    symbols: (song: "󰝚 ", dir: "󱍙 ", playlist: "󰲸 ", marker: "* ", ellipsis: "...",
        song_style: (fg: "#6f9bd1"), song_highlighted_style: None, song_current_style: (fg: "#1c2128"),
        dir_style: (fg: "#6f9bd1"), dir_highlighted_style: None, dir_current_style: (fg: "#1c2128"),
        playlist_style: (fg: "#6f9bd1"), playlist_highlighted_style: None, playlist_current_style: (fg: "#1c2128"),
        marker_style: (fg: "#d4b87a"), marker_highlighted_style: (fg: "#d4b87a"), marker_current_style: (fg: "#1c2128", bg: "#d4b87a" ),
    ),
    progress_bar: (
        symbols: ["", "█", "", "█", "" ],
        track_style: (fg: "#2a313c", bg: "#1c2128"),
        elapsed_style: (fg: "#6f9bd1", bg: "#1c2128"),
        thumb_style: (fg: "#6f9bd1", bg: "#2a313c"),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["┋", "█", "󰄿", "󰄼"],
        track_style: (fg: "#6f9bd1"),
        ends_style: (fg: "#6f9bd1"),
        thumb_style: (fg: "#6f9bd1"),
    ),
    song_table_format: [
        (prop: (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
            (match:  "0", replace: (kind: Group([(kind: Text("󰎡"),style: (fg: "#6f9bd1"))]))),
            (match:  "1", replace: (kind: Group([(kind: Text("󰎤"),style: (fg: "#6f9bd1"))]))),
            (match:  "2", replace: (kind: Group([(kind: Text("󰎧"),style: (fg: "#6f9bd1"))]))),
            (match:  "3", replace: (kind: Group([(kind: Text("󰎪"),style: (fg: "#6f9bd1"))]))),
            (match:  "4", replace: (kind: Group([(kind: Text("󰎭"),style: (fg: "#6f9bd1"))]))),
            (match:  "5", replace: (kind: Group([(kind: Text("󰎱"),style: (fg: "#6f9bd1"))]))),
            (match:  "6", replace: (kind: Group([(kind: Text("󰎳"),style: (fg: "#6f9bd1"))]))),
            (match:  "7", replace: (kind: Group([(kind: Text("󰎶"),style: (fg: "#6f9bd1"))]))),
            (match:  "8", replace: (kind: Group([(kind: Text("󰎹"),style: (fg: "#6f9bd1"))]))),
            (match:  "9", replace: (kind: Group([(kind: Text("󰎼"),style: (fg: "#6f9bd1"))]))),
            (match: "10", replace: (kind: Group([(kind: Text("󰽽"),style: (fg: "#6f9bd1"))]))),
        ])), default: (kind: Text(""), style: (fg: "#6b7686"))),
        width: "3",
        label: "Rating",
        alignment: Center,
            label_prop: (kind: Group([
                (kind: Text("󰩳"), style: (fg: "#6f9bd1")),
            ]))
        ),
        (prop: (kind: Sticker("playCount"),style: (fg: "#6f9bd1"),
            default: (kind: Text(""), style: (fg: "#6b7686"))),
            width: "3",
            alignment: Left,
            label: "Playcount",
            label_prop: (kind: Group([
                (kind: Text("󰆙"), style: (fg: "#6f9bd1")),
            ]))
        ),
        (prop:(kind: Text("│"), style: (fg: "#6f9bd1")),
            width: "1",
            alignment: Center,
            label: "",
            label_prop: (kind: Group([
                (kind: Text("│"), style: (fg: "#6f9bd1")),
            ]))
        ),
        (prop: (kind: Property(Artist), style: (fg: "#6f9bd1"),
            default: (kind: Text("Unknown Artist"), style: (fg: "#6b7686"))),
            width: "23%",
            label_prop: (kind: Group([
                (kind: Text("Artist "), style: (fg: "#c9d1d9")),
                (kind: Text(""), style: (fg: "#6f9bd1"))
            ]))
        ),
        (prop: (kind: Property(Title), style: (fg: "#9db4cc"),
            default: (kind: Property(Filename), style: (fg: "#c9d1d9"),
                default: (kind: Text("Unknown Title"), style: (fg: "#c9d1d9")))),
            width: "36%",
            label_prop: (kind: Group([
                (kind: Text("Title "), style: (fg: "#c9d1d9")),
                (kind: Text(""), style: (fg: "#6f9bd1"))
            ]))
        ),
        (prop: (kind: Property(Album), style: (fg: "#6f9bd1"),
            default: (kind: Text("Unknown Album"), style: (fg: "#6b7686"))),
            width: "33%",
            label_prop: (kind: Group([
                (kind: Text("Album "), style: (fg: "#c9d1d9")),
                (kind: Text("󰀥"), style: (fg: "#6f9bd1"))
            ]))
        ),
        (prop: (kind: Property(Duration), style: (fg: "#9db4cc"),
            default: (kind: Text("-"))),
            width: "8%",
            alignment: Right,
            label_prop: (kind: Group([
                (kind: Text("Length "), style: (fg: "#c9d1d9")),
                (kind: Text(" "), style: (fg: "#6f9bd1"))
            ]))
        ),
    ],
    layout: Split(direction: Vertical, panes: [
        (size: "7", borders: "NONE", pane: Component("header")),
        (size: "100%", borders: "NONE", pane: Pane(TabContent)),
        (size: "3", borders: "NONE", pane: Component("progress_bar")),
    ]),
    browser_song_format: [
        (kind: Group([
            (kind: Property(Track)),
            (kind: Text(" ")),
        ])),
        (kind: Group([
            (kind: Property(Artist)),
            (kind: Text(" - ")),
            (kind: Property(Title)),
        ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
        info:  (fg: "#8fb996", bg: "#1c2128"),
        warn:  (fg: "#d4b87a", bg: "#1c2128"),
        error: (fg: "#c46a72", bg: "#1c2128"),
        debug: (fg: "#c98a6b", bg: "#1c2128"),
        trace: (fg: "#9a8fb8", bg: "#1c2128"),
    ),
    components: {
        "header_tab_bar": Split(direction: Horizontal, panes: [
            (size: "11%", borders: "NONE", pane: Component("tab_bar_left")),
            (size: "78%", borders: "NONE", pane: Pane(Tabs)),
            (size: "11%", borders: "NONE", pane: Component("tab_bar_right")),
        ]),
        "header_line_1": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_1")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_2")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_3")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_2": Split(direction: Horizontal, panes: [
            (size: "22%", pane: Component("header_element_4")),
            (size: "1", pane: Component("header_element_space")),
            (size: "56%", pane: Component("header_element_5")),
            (size: "1", pane: Component("header_element_space")),
            (size: "22%", pane: Component("header_element_6")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header_line_3": Split(direction: Horizontal, panes: [
            (size: "25%", pane: Component("header_element_7")),
            (size: "1", pane: Component("header_element_space")),
            (size: "50%", pane: Component("header_element_8")),
            (size: "1", pane: Component("header_element_space")),
            (size: "25%", pane: Component("header_element_9")),
            (size: "2", pane: Component("header_element_right_end")),
        ]),
        "header": Split(direction: Vertical, panes: [
            (size: "2", borders: "TOP | RIGHT | LEFT", border_symbols: Rounded,
                pane: Split(direction: Horizontal, panes: [
                    (size: "100%", borders: "NONE", pane: Component("header_tab_bar")),
                ])
            ),
            (size: "5", borders: "ALL", border_symbols: Library("rounded_collapsed_top"),
                border_title: [
                    (kind: Text("─"), style: (fg: "#6f9bd1")),
                    (kind: Transform(Replace(content: (kind: Sticker("like")), replacements: [
                        (match:  "0", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("󰋔 "), style: (fg: "#c46a72")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "1", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("󰋕 "), style: (fg: "#d4b87a")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "2", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text(" "), style: (fg: "#8fb996")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                    ]))),
                    (kind: Text("─"), style: (fg: "#6f9bd1")),
                    (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
                        (match:  "0", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("     "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "1", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text(" "),         style: (fg: "#9db4cc")), (kind: Text("    "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "2", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text(" "),         style: (fg: "#9db4cc")), (kind: Text("    "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "3", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("  "),       style: (fg: "#9db4cc")), (kind: Text("   "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "4", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("  "),       style: (fg: "#9db4cc")), (kind: Text("   "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "5", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("   "),     style: (fg: "#9db4cc")), (kind: Text("  "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "6", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("   "),     style: (fg: "#9db4cc")), (kind: Text("  "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "7", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("    "),   style: (fg: "#9db4cc")), (kind: Text(" "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "8", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("    "),   style: (fg: "#9db4cc")), (kind: Text(" "), style: (fg: "#6f9bd1")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match:  "9", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("     "), style: (fg: "#9db4cc")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                        (match: "10", replace: (kind: Group([(kind: Text("["), style: (fg: "#6f9bd1")), (kind: Text("     "), style: (fg: "#9db4cc")), (kind: Text("]"), style: (fg: "#6f9bd1"))]))),
                    ])), default: (kind: Text("─"),style: (fg: "#6f9bd1"))),
                    (kind: Text("─"), style: (fg: "#6f9bd1")),
                ],
                border_title_position: Bottom,
                border_title_alignment: Right,
                pane: Split(direction: Vertical, panes: [
                    (size: "100%", borders: "NONE", pane: Component("header_line_1")),
                    (size: "100%", borders: "NONE", pane: Component("header_line_2")),
                    (size: "100%", borders: "NONE", pane: Component("header_line_3")),
                ])
            ),
        ]),
        "progress_bar": Split(direction: Vertical, panes: [
            (size: "3", borders: "ALL", border_symbols: Rounded ,
                border_title: [
                    (kind: Property(Status(Elapsed)),style: (fg: "#c9d1d9")),
                    (kind: Property(Status(StateV2(playing_label: "─󱦟─", paused_label: "  ", stopped_label: "  "))),
                        style: (fg: "#6f9bd1", modifiers: "Bold")),
                    (kind: Property(Status(Duration)),style: (fg: "#c9d1d9")),
                ],
                border_title_position: Top,
                border_title_alignment: Center,
                pane: Split(direction: Vertical, panes: [
                    (size: "100%", borders: "NONE",pane: Pane(ProgressBar)),
                ])
            ),
        ]),
        "tab_bar_left": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text(" "), style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(StateV2(playing_label: "", paused_label: "", stopped_label: ""))),
                    style: (fg: "#c9d1d9")),
                (kind: Text("  "), style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Song(FileExtension)), style: (fg: "#6b7686")),
                (kind: Text(" ")),
                (kind: Property(Widget(ScanStatus)), style: (fg: "#c9d1d9", modifiers: "Bold")),
                (kind: Text(" ")),
                (kind: Property(Status(InputBuffer())), style: (fg: "#6b7686")),
            ], align: Left))),
        ]),
        "tab_bar_right": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content: (kind: Property(Status(Partition)), style: (fg: "#6b7686")), replacements: [
                    (match:  "default", replace: (kind: Group([(kind: Text(""))]))),
                ]))),
                (kind: Text(" ")),
                (kind: Property(Song(Channels())), style: (fg: "#6b7686"),
                    default: (kind: Text("0"), style: (fg: "#6b7686"))),
                (kind: Text(" 󱡫 "),style: (fg: "#6b7686")),
                (kind: Text(" 󱡬"), style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(Volume)), style: (fg: "#c9d1d9")),
                (kind: Text("% "), style: (fg: "#6f9bd1", modifiers: "Bold"))
            ], align: Right))),
        ]),
        "header_element_1": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(Elapsed)),style: (fg: "#c9d1d9")),
                (kind: Text(" / "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(Duration)),style: (fg: "#c9d1d9")),
                (kind: Text(" 󱦟"),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Text(" ]"),style: (fg: "#6f9bd1", modifiers: "Bold")),
            ], align: Left))),
        ]),
        "header_element_2": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Property(Song(Title)), style: (fg: "#c9d1d9",modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#c9d1d9",modifiers: "Bold"),
                        default: (kind: Text("Unknown Title"), style: (fg: "#c9d1d9",modifiers: "Bold"))
                    )
                )
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_3": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(RepeatV2(on_label: "", off_label: "",
                    on_style: (fg: "#c9d1d9", modifiers: "Bold"),
                    off_style: (fg: "#6b7686", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(RandomV2(on_label: "", off_label: "",
                    on_style: (fg: "#c9d1d9", modifiers: "Bold"),
                    off_style: (fg: "#6b7686", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(ConsumeV2(on_label: "󰮯", off_label: "󰮯", oneshot_label: "󰮯󰇊",
                    on_style: (fg: "#c9d1d9", modifiers: "Bold"),
                    off_style: (fg: "#6b7686", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(SingleV2(on_label: "󰎤", off_label: "󰎦", oneshot_label: "󰇊", off_oneshot_label: "󱅊",
                    on_style: (fg: "#c9d1d9", modifiers: "Bold"),
                    off_style: (fg: "#6b7686", modifiers: "Bold"))))
                ),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(Crossfade)),style: (fg: "#6b7686"),
                    default: (kind: Text("󰴽"), style: (fg: "#6b7686"))
                ),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match:  "Normal", replace: (kind: Group([(kind: Text("N"),style: (fg: "#6b7686", modifiers: "Bold"))]))),
                    (match:  "Insert", replace: (kind: Group([(kind: Text("I"),style: (fg: "#c9d1d9", modifiers: "Bold"))]))),
                ]))),
            ], align: Right))),
        ]),
        "header_element_4": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Song(Bits())),default: (kind: Text(" "), style: (fg: "#c9d1d9")), style: (fg: "#c9d1d9")),
                (kind: Text(" bit"),style: (fg: "#6f9bd1")),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(Bitrate)),default: (kind: Text(" "), style: (fg: "#c9d1d9")),style: (fg: "#c9d1d9")),
                (kind: Text(" kbps"),style: (fg: "#6f9bd1")),
                (kind: Text(" ]"),style: (fg: "#6f9bd1", modifiers: "Bold"))
            ], align: Left))),
        ]),
        "header_element_5": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Artist)), style: (fg: "#9db4cc"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#9db4cc"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Artist"), style: (fg: "#9db4cc"))])))]
                ))),
                (kind: Text(" - "), style: (fg: "#c9d1d9")),
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Album)),style: (fg: "#6f9bd1" ),
                        default: (kind: Text("Unknown Album"), style: (fg: "#6f9bd1"))
                    ), replacements: [(match:  "", replace: (kind: Group([(kind: Text("Unknown Album"), style: (fg: "#6f9bd1"))])))]
                ))),
            ], align: Center, scroll_speed: 6))),
        ]),
        "header_element_6": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeRemaining(separator: " "))),style: (fg: "#c9d1d9")),
                (kind: Text(" / "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(QueueTimeTotal(separator: " "))),style: (fg: "#c9d1d9")),
                (kind: Text(" 󱎫"),style: (fg: "#6f9bd1", modifiers: "Bold")),
            ], align: Right))),
        ]),
        "header_element_7": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Text("[ "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Song(SampleRate())), default: (kind: Text(" "), style: (fg: "#c9d1d9")), style: (fg: "#c9d1d9")),
                (kind: Text(" Hz"),style: (fg: "#6f9bd1")),
                (kind: Text(" | "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Song(Position)), style: (fg: "#c9d1d9"), default: (kind: Text("0"), style: (fg: "#c9d1d9"))),
                (kind: Text(" / "),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Property(Status(QueueLength())),style: (fg: "#c9d1d9")),
                (kind: Text(" 󰴍"),style: (fg: "#6f9bd1", modifiers: "Bold")),
                (kind: Text(" ]"),style: (fg: "#6f9bd1", modifiers: "Bold"))
            ], align: Left))),
        ]),
        "header_element_8": Split(direction: Horizontal, panes: [
            (size: "100%", pane: Pane(Property(content: [
                (kind: Transform(Replace(content:
                    (kind: Property(Song(Other("albumartist"))),style: (fg: "#6b7686"),
                        default: (kind: Text("Unknown Albumartist"), style: (fg: "#6b7686"))
