@import "/home/derilkarf/.cache/wal/colors.mine.rasi"

configuration {
  modi: "drun,run";
  show-icons: true;
  drun-display-format: "{name}";
}

* { font: "JetBrainsMono Nerd Font 12"; }

window {
  width: 620px;
  background-color: @background;
  border: 2px;
  border-color: @color4;
  border-radius: 14px;
}

mainbox { 
  padding: 16px; 
  spacing: 12px; 
  background-color: transparent; 
  }

inputbar {
  padding: 10px 14px;
  spacing: 8px;
  border-radius: 10px;
  background-color: @color0;
  children: [prompt, entry];
}

prompt { 
  text-color: @color4; 
  background-color: transparent; 
  }

entry { 
  text-color: @foreground; 
  placeholder: "Search apps..."; 
  placeholder-color: @color8; 
  background-color: transparent; 
  }

listview { 
  lines: 5; 
  columns: 1; 
  spacing: 4px; 
  scrollbar: true; 
  background-color: transparent; 
  border: 0px;
  fixed-height: false;
  }

element { 
  padding: 8px 12px; 
  border-radius: 10px; 
  background-color: transparent; 
  text-color: @foreground; 
  }

element selected.normal { 
  background-color: @color4; 
  text-color: @background; 
  }

element-icon { 
  size: 1.6em; 
  background-color: transparent; 
  }
element-text { 
  background-color: transparent; 
  text-color: inherit; 
  }

element normal.normal, element alternate.normal {
  background-color: transparent;
  text-color: @foreground;
}

