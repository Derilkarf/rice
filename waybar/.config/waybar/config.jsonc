{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin": "6 10 0 10",

  "modules-left": ["hyprland/workspaces", "mpd"],

  "modules-center": ["clock"],

  "modules-right": 
  [ "cpu", 
    "memory", 
    "pulseaudio", 
    "backlight", 
    "network", 
    "battery",
    "custom/devices",
    "tray",
    "custom/exit"
     ],


  "custom/devices": {
    "exec": "~/.config/waybar/scripts/devices.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "dolphin /run/media/$USER",
    "on-click-right": "udiskie-umount --all"
  },

  "custom/exit": {
      "format": " ",
      "tooltip-format": "Powermenu",
      "on-click": "wlogout -b 4",
      "tooltip": false
    },

  "hyprland/workspaces": { 
    "format": "{id}", 
    "on-click": "activate" 
  },

 "mpd": {
  "format": "󰎆 {title}",
  "format-paused": "󰏤 {title}",
  "format-stopped": "󰓛 stopped",
  "format-disconnected": "󰎊 mpd off",
  "max-length": 30,
  "tooltip-format": "{artist} - {title}\n{album}",
  "on-click": "kitty --class rmpc-popup -e rmpc"
  },

  "clock": { 
    "format": "{:%H:%M}", 
    "tooltip-format": "{:%A, %d %B %Y}" 
  },
  
  "cpu": { 
    "format": "󰻠 {usage}%" 
  },
  
  "memory": { 
    "format": "󰍛 {percentage}%" 
  },
  
  "pulseaudio": { 
    "format": "󰕾 {volume}%", 
    "format-muted": "󰝟 muted", 
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    // Scroll Pake Mouse Untuk Alternatif nurunin / nambahin volume
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%-"
  },

  "backlight": { 
    "format": "󰃟 {percent}%" 
  },
  
  "network": { 
    "format-wifi": "󰖩 {essid}", 
    "format-disconnected": "󰖪 off", 
    "on-click": "kitty nmtui" 
  },

  "battery": { 
    "format": "󰁹 {capacity}%", 
    "format-charging": "󰂄 {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
